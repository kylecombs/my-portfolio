{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "apps", "scripts"],
  // Polaris bundles its own @types/react, which clashes with ours; esbuild builds the mocks untyped.
  "exclude": ["apps/*/mock"]
}
